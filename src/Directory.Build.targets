<!-- Directory.Build.targets -->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Import parent Directory.Build.targets to get CopyYamlContracts target -->
    <PropertyGroup>
        <ParentDirectoryBuildTargetsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..\'))</ParentDirectoryBuildTargetsPath>
    </PropertyGroup>
    <ImportGroup>
        <Import Project="$(ParentDirectoryBuildTargetsPath)" />
    </ImportGroup>

    <Target Name="RemoveRedundantDirectoriesAfterPublish" AfterTargets="Publish">
        <ItemGroup>
            <!-- Removes files due to transient dependency on sqlite -->
            <DirsToDelete Include="$(PublishDir)/runtimes" />
        </ItemGroup>
        <RemoveDir Directories="@(DirsToDelete)">
            <Output TaskParameter="RemovedDirectories" ItemName="RemovedDirs" />
        </RemoveDir>
        <Message Importance="high" Text="RemoveRedundantFilesAfterPublish: Removed directory %(RemovedDirs.Identity)" />
    </Target>
<!-- 
    <Target Name="RemoveRedundantFilesAfterPublish" AfterTargets="Publish">
        <ItemGroup>
            <FilesToDelete Include="$(PublishDir)/**/*sqlite*" />
        </ItemGroup>
        <Delete Files="@(FilesToDelete)">
            <Output TaskParameter="DeletedFiles" ItemName="DeletedFiles" />
        </Delete>
        <Message Importance="high" Text="RemoveRedundantFilesAfterPublish: Removed file %(DeletedFiles.Identity)" />
    </Target>
 -->

    
    
</Project>
